                "content": ".content, main, .body",
                "links": ".sidebar a, .nav a"
            },
            "valid_paths": ["/getstarted/", "/editor/", "/languages/"],
            "max_depth": 2
        },
        "postman": {
            "base_url": "https://learning.postman.com/docs/",
